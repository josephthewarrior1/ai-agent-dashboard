# Publish the application source only.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/office-standalone/

/office-standalone/*
!/office-standalone/app.py
!/office-standalone/README.md
!/office-standalone/web/
!/office-standalone/tests/
!/office-standalone/frontend/

/office-standalone/tests/*
!/office-standalone/tests/test_*.py
!/office-standalone/tests/test_*.cjs
!/office-standalone/tests/test_*.mjs

**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*cookies*
**/snapshot.json
**/*.log
**/.local/
**/.runtime/
**/node_modules/
**/.vite/
